# Copy this file to .env and fill in your values. Never commit .env.
# OLLAMA_MODEL=llama3.2
OLLAMA_MODEL=llama3.2:latest
EMBED_MODEL=nomic-embed-text
NUM_CTX=8192
MAX_HISTORY_MESSAGES=16

# Free key from alphavantage.co (regenerate the old one that was in the code)
ALPHA_VANTAGE_KEY=YWR46LNTBYE1RWN5

DB_PATH=chatbot.db
INDEX_DIR=faiss_indexes
MAX_PDF_MB=20

# similarity or mmr
RETRIEVAL_SEARCH_TYPE=similarity
RETRIEVAL_K=4

# true = ask the model for a short title after each first message (slower on CPU)
USE_LLM_TITLES=false
